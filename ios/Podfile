# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SynchroniReactNativeDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # The vendored sensor.xcframework simulator slice is arm64-only
    # (third_party/sensorcxx/ios/sensor.xcframework/ios-arm64-simulator).
    # Exclude x86_64 from every simulator build (app + all pod targets) so the
    # linker never looks for sen_* symbols in a nonexistent slice.
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |bc|
          bc.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
        end
      end
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        bc.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      end
    end
    # generated_projects does NOT include the user (app) project — without
    # this the app target keeps the template's empty EXCLUDED_ARCHS and the
    # simulator link fails on the arm64-only pod products.
    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next unless user_project
      user_project.targets.each do |target|
        target.build_configurations.each do |bc|
          bc.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
        end
      end
      user_project.save
    end
  end
end
